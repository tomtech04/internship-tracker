// Prisma schema for the internship application tracker.
// SQLite has no native enum support, so status/source/tier/etc. are plain
// strings whose allowed values are enforced by Zod in src/lib/validation.ts.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Company {
  id      String  @id @default(cuid())
  name    String  @unique
  website String?

  // Portal login for this company's application system (Workday,
  // Greenhouse, etc.) — shared across every application to this company.
  // portalPassword is plaintext: this is a single-user local SQLite file
  // with no auth layer, so there's no master password to encrypt it
  // against. See README's security notes before relying on this instead
  // of a real password manager.
  portalUsername String?
  portalPassword String?

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  applications Application[]
}

model Application {
  id        String  @id @default(cuid())
  roleTitle String
  team      String?
  location  String?
  jobUrl    String?
  reqId     String?

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  source        String
  resumeVersion String
  tier          String
  status        String @default("Wishlist")

  dateApplied       DateTime?
  deadline          DateTime?
  followUpDate      DateTime?
  nextInterviewDate DateTime?

  referralId String?
  referral   Contact? @relation(fields: [referralId], references: [id])

  itarRestricted Boolean @default(false)
  compensation   String?
  notes          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events Event[]

  @@index([status])
  @@index([referralId])
  @@index([companyId])
}

model Contact {
  id   String @id @default(cuid())
  name String

  company      String?
  role         String?
  relationship String
  howWeMet     String?
  email        String?
  linkedinUrl  String?

  lastContactedDate DateTime?
  nextStep          String?
  notes             String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  applications Application[]
}

model Event {
  id            String      @id @default(cuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  type        String
  date        DateTime @default(now())
  description String

  createdAt DateTime @default(now())

  @@index([applicationId])
}
